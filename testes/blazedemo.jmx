            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Ler token do formulario quando presente" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters" />
              <stringProp name="filename" />
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def doc = org.jsoup.Jsoup.parse(prev.getResponseDataAsString())
vars.put('token', doc.select('input[name=_token]').attr('value'))
if (doc.select('input[name=inputName]').isEmpty()) {
    prev.setSuccessful(false); prev.setResponseMessage('Formulario de compra ausente')
}</stringProp>
            </JSR223PostProcessor>
            <hashTree />
