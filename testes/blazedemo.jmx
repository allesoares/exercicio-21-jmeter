        <intProp name="ThreadGroup.num_threads">50</intProp>
        <intProp name="ThreadGroup.ramp_time">180</intProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <collectionProp name="ultimatethreadgroupdata">
          <collectionProp name="perfil">
            <stringProp name="0">50</stringProp>
            <stringProp name="1">0</stringProp>
            <stringProp name="2">180</stringProp>
            <stringProp name="3">300</stringProp>
            <stringProp name="4">120</stringProp>
          </collectionProp>
        </collectionProp>
      </kg.apc.jmeter.threads.UltimateThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Passageiros ficticios - CSV" enabled="true">
