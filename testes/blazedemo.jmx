            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validar identificador da confirmacao" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters" />
              <stringProp name="filename" />
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def doc = org.jsoup.Jsoup.parse(prev.getResponseDataAsString())
def idRow = doc.select('tr').find { it.select('td').size() &gt;= 2 &amp;&amp; it.select('td').get(0).text() == 'Id' }
if (idRow == null || idRow.select('td').get(1).text().trim().isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Confirmacao sem identificador da compra')
}</stringProp>
            </JSR223Assertion>
            <hashTree />
