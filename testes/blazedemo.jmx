          <elementProp name="servidor" elementType="Argument">
            <stringProp name="Argument.name">servidor</stringProp>
            <stringProp name="Argument.value">${__P(servidor,blazedemo.com)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
