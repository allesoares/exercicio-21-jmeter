      <kg.apc.jmeter.threads.UltimateThreadGroup guiclass="kg.apc.jmeter.threads.UltimateThreadGroupGui" testclass="kg.apc.jmeter.threads.UltimateThreadGroup" testname="50 usuarios - subida 180s - carga 300s - descida 120s" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">startnextloop</stringProp>
